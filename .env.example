# Database connection string
# Local development: "file:./dev.db"
# Production (Turso): "libsql://[database-name]-[org].turso.io"
DATABASE_URL="file:./dev.db"

# Turso Authentication Token (Required for production deployment with Turso)
# Leave empty for local SQLite development
TURSO_AUTH_TOKEN=""

# Groq API Configuration for AI Question Enhancement & Question Generation
# Get your API key from https://console.groq.com/ (Optional, offline deterministic fallbacks available)
GROQ_API_KEY=""

# Optional: Groq LLM model name (default: openai/gpt-oss-120b)
GROQ_MODEL="openai/gpt-oss-120b"

